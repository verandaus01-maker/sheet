# Database Configuration
# For Vercel Postgres (Required for production deployment)
# Get these from: https://vercel.com/dashboard -> Storage -> Create Database -> Postgres
DATABASE_URL="postgres://default:xxx@xxx.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
DIRECT_URL="postgres://default:xxx@xxx.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# Environment
NODE_ENV=development

# Optional: Prisma settings
PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
